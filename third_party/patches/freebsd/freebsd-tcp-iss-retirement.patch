+/*
+ * Retire the ISS bound before snd_una advances far enough to make sequence
+ * comparisons against ISS ambiguous. Both ACK processing paths must maintain
+ * this state, since header prediction bypasses general ACK processing.
+ */
+static inline void
+tcp_maybe_retire_iss_check(struct tcpcb *tp)
+{
+
+	if ((tp->t_flags2 & TF2_NO_ISS_CHECK) == 0 &&
+	    SEQ_GT(tp->snd_una, tp->iss + (TCP_MAXWIN << tp->snd_scale)))
+		tp->t_flags2 |= TF2_NO_ISS_CHECK;
+}
+
