---
Checks: '-*,readability-identifier-naming'
WarningsAsErrors: 'readability-identifier-naming'
HeaderFilterRegex: '(^|.*/)(src|example)/.*|(^|.*/)include/bycorf/(io|net|rpc)/.*|(^|.*/)include/bycorf/runtime/(coroutine_frame_pool|cross_core|runtime|sync|task|worker)\.h'
CheckOptions:
  readability-identifier-naming.AggressiveDependentMemberLookup: true
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.PublicMemberSuffix: '_'
...
